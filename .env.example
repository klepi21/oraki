# --- Clerk (tutor auth only — students never get a Clerk account) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Supabase (RLS is the privacy backbone — see supabase/migrations/) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Never expose to the client. Bypasses RLS entirely.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price object for the per-student metered item (€2/student/month).
STRIPE_PRICE_ID_PER_STUDENT=

# --- Resend (transactional email) ---
RESEND_API_KEY=

# Public URL of the deployed app, used to build shareable student links
# (e.g. https://oraki.gr/ger1/gerdinos-x7fq2k9a2b).
NEXT_PUBLIC_APP_URL=https://oraki.gr
